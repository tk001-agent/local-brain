[Unit]
Description=Local Brain Agent - Dialog Recording & Topic Extraction
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/local-brain
ExecStart=/home/ubuntu/local-brain/venv/bin/gunicorn -w 2 -b 0.0.0.0:18900 server:app
Restart=always
RestartSec=5
Environment=PATH=/home/ubuntu/local-brain/venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target